# ─────────────────────────────────────────────────────────────
# ShoMate 백엔드 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  .env 는 절대 커밋/배포물에 포함하지 마세요.
# ─────────────────────────────────────────────────────────────

# Google AI Studio에서 발급한 Gemini API 키. 이 서버에만 존재해야 합니다.
GEMINI_API_KEY=

# 사용할 모델 (기본 gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# 허용할 크롬 확장 ID. 비워두면 모든 chrome-extension:// 오리진을 허용합니다(개발용).
# 스토어 배포 후에는 반드시 실제 확장 ID를 넣으세요. 쉼표로 여러 개 가능.
SHOMATE_ALLOWED_EXTENSION_IDS=

# IP당 분당 허용 요청 수
SHOMATE_RATE_LIMIT_PER_MIN=20

# 프롬프트 최대 길이(문자). 초과 시 413.
SHOMATE_MAX_PROMPT_CHARS=20000

# Gemini 응답 대기 상한(초)
SHOMATE_UPSTREAM_TIMEOUT_S=30

# ── 토스페이먼츠 (테스트 모드) ─────────────────────────────────
# 본인 키는 토스 개발자센터 > 내 개발정보 > API 개인키 에서 발급.
# test_ 로 시작하는 키만 쓰는 한 실제 청구는 발생하지 않는다.
TOSS_CLIENT_KEY=test_ck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_sk_docs_Ovk5rk1EwkEbP0W43n07xlzm

# 토스가 결제 후 리다이렉트할 주소. 로컬 개발이면 그대로 둔다.
SHOMATE_PUBLIC_URL=http://localhost:8000

# 구독 라이선스 서명 키. 비워두면 서버 재시작마다 새로 생성되어
# 기존에 발급한 구독 토큰이 전부 무효가 된다. 운영에서는 반드시 고정할 것.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SHOMATE_LICENSE_SECRET=
