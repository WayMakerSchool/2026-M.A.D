{
  "manifest_version": 3,
  "name": "ShoMate",
  "version": "1.9.2",
  "description": "마이데이터 기반 스마트 안심 쇼핑 비서",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.coupang.com/*",
    "*://*.11st.co.kr/*",
    "*://*.shopping.naver.com/*",
    "*://*.smartstore.naver.com/*",
    "*://*.brand.naver.com/*",
    "*://*.gmarket.co.kr/*",
    "*://*.auction.co.kr/*",
    "*://*.interpark.com/*",
    "*://*.lotteon.com/*",
    "*://*.ssg.com/*",
    "*://*.tmon.co.kr/*",
    "*://openapi.naver.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ShoMate 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/*",
        "icons/*"
      ],
      "matches": [
        "*://*.coupang.com/*",
        "*://*.11st.co.kr/*",
        "*://*.shopping.naver.com/*",
        "*://*.smartstore.naver.com/*",
        "*://*.brand.naver.com/*",
        "*://*.gmarket.co.kr/*",
        "*://*.auction.co.kr/*",
        "*://*.interpark.com/*",
        "*://*.lotteon.com/*",
        "*://*.ssg.com/*",
        "*://*.tmon.co.kr/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.coupang.com/*",
        "*://*.11st.co.kr/*",
        "*://*.shopping.naver.com/*",
        "*://*.smartstore.naver.com/*",
        "*://*.brand.naver.com/*",
        "*://*.gmarket.co.kr/*",
        "*://*.auction.co.kr/*",
        "*://*.interpark.com/*",
        "*://*.lotteon.com/*",
        "*://*.ssg.com/*",
        "*://*.tmon.co.kr/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
